{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capture-iv-landing-page",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-19",
  "build": {"command": "npm run build"},
  // run_worker_first routes the hero video through the Worker so it can serve HTTP range (206) requests for smooth seeking; other assets are served directly.
  "assets": {"directory": "dist/public", "binding": "ASSETS", "run_worker_first": ["/capture-iv-product-tour.mp4"]},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "construct-iv-inquiries",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "drizzle"
  }]
}
